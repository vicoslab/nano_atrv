    </link>

    <joint name="base_footprint_to_base_link" type="fixed">
        <parent link="base_footprint"/>
        <child link="base_link"/>
        <origin xyz="0 0 0.18" rpy="0 0 0"/>
    </joint>

    <link name="laser"/>
    <joint name="base_link_to_laser" type="fixed">
        <parent link="base_link"/>
        <child link="laser"/>
        <origin xyz="0 0 0.22" rpy="0 3.1415 0"/>
    </joint>

    <link name="camera_link">
        <visual>
            <origin xyz="-0.025 -0.11 -0.01" rpy="1.5708 0 1.5708" />
            <geometry><mesh filename="package://nano_atrv_description/meshes/vehicle/camera.stl" scale="0.001 0.001 0.001" /></geometry>
            <material name="red"/>
        </visual>
    </link>
    <joint name="base_link_to_camera_link" type="fixed">
        <parent link="base_link"/>
        <child link="camera_link"/>
        <origin xyz="0.08 0.05 0.285" rpy="0 0.8029 0"/>
    </joint>

    <link name="camera_color_optical_frame"/>
    <joint name="camera_to_color_optical_joint" type="fixed">
        <parent link="camera_link"/>
        <child link="camera_color_optical_frame"/>
        <origin xyz="0 0 0" rpy="-1.5708 0 -1.5708"/>
    </joint>

    <link name="camera_depth_optical_frame"/>
