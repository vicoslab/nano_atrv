    </link>
    <joint name="rear_steer_joint" type="revolute">
        <parent link="base_link"/>
        <child link="rear_wheel_link"/>
        <origin xyz="-0.175 0 -0.175" rpy="0 0 0"/>
        <axis xyz="0 0 1"/>
        <limit lower="-3.1415" upper="3.1415" effort="10" velocity="2"/>
    </joint>

    <link name="left_wheel">
        <visual>
            <origin xyz="0 0 0" rpy="0 1.5708 0" />
            <geometry><cylinder radius="0.075" length="0.05" /></geometry>
            <material name="black"/>
        </visual>
    </link>
    <joint name="left_wheel_joint" type="continuous">
        <parent link="left_wheel_link"/>
        <child link="left_wheel"/>
