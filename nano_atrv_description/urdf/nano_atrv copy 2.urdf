    <joint name="arm_Shoulder_Rotation" type="revolute">
        <origin xyz="0 -0.0452 0.0165" rpy="1.5708 0 0" />
        <parent link="arm_Base" />
        <child link="arm_Shoulder_Rotation_Pitch" />
        <axis xyz="0 -1 0" />
        <limit effort="1000" lower="-1.96" upper="1.96" velocity="5.0"/>
        <dynamics damping="0.1"/>
    </joint>

    <joint name="arm_Shoulder_Pitch" type="revolute">
        <origin xyz="0 0.1025 0.0306" rpy="0 0 0" />
        <parent link="arm_Shoulder_Rotation_Pitch" />
        <child link="arm_Upper_Arm" />
        <axis xyz="1 0 0" />
        <limit effort="1000" lower="-1.745" upper="1.745" velocity="5.0"/>
        <dynamics damping="0.1"/>
    </joint>

