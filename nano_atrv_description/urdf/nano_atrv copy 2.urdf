        <parent link="arm_Upper_Arm" />
        <child link="arm_Lower_Arm" />
        <axis xyz="1 0 0" />
        <limit effort="1000" lower="-1.5" upper="1.5" velocity="5.0"/>
        <dynamics damping="0.1"/>
    </joint>

    <joint name="arm_Wrist_Pitch" type="revolute">
        <origin xyz="0 0.0052 0.1349" rpy="-1.57079 0 0" />
        <parent link="arm_Lower_Arm" />
        <child link="arm_Wrist_Pitch_Roll" />
        <axis xyz="1 0 0" />
        <limit effort="1000" lower="-1.658" upper="1.658" velocity="5.0"/>
        <dynamics damping="0.1"/>
    </joint>

    <joint name="arm_Wrist_Roll" type="revolute">
        <origin xyz="0 -0.0601 0" rpy="0 1.57079 0" />
        <parent link="arm_Wrist_Pitch_Roll" />
        <child link="arm_Fixed_Gripper" />
        <axis xyz="0 1 0" />
        <limit effort="1000" lower="-2.75" upper="2.75" velocity="5.0"/>
        <dynamics damping="0.1"/>
    </joint>

    <joint name="arm_Gripper" type="revolute">
        <origin xyz="-0.0202 -0.0244 0" rpy="3.1416 0 3.1416" />
        <parent link="arm_Fixed_Gripper" />
        <child link="arm_Moving_Jaw" />
        <axis xyz="0 0 1" />
        <limit effort="1000" lower="-0.1792" upper="1.5708" velocity="5.0"/>
        <dynamics damping="0.1"/>
    </joint>

    <joint name="arm_End_Effector_Joint" type="fixed">
        <parent link="arm_Fixed_Gripper"/>
        <child link="arm_End_Effector"/>
        <origin xyz="0.0 -0.09 0.0" rpy="0 0 0"/>
    </joint>

</robot>
