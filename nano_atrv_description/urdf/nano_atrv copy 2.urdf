        <child link="base_link_arm"/>
        <origin xyz="0.145 0 0" rpy="0 0 1.5708"/>
    </joint>

    <joint name="base_link_arm_to_arm_base" type="fixed">
        <parent link="base_link_arm"/>
        <child link="arm_base_link"/>
